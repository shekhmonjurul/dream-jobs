// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model JobType {
  id    Int    @id @default(autoincrement())
  name  String @unique // e.g., 'Government', 'Private'
  jobs  Job[]
}

model SalaryScale {
  id        Int    @id @default(autoincrement())
  scaleName String @unique // e.g., 'Grade 9'
  minSalary Int?
  maxSalary Int?
  jobs      Job[]
}

model Job {
  id             String    @id @default(uuid())
  designation    String    // পদের নাম
  vacancies      Int?      // শূন্যপদ
  minAge         Int?      @default(18)
  maxAge         Int?      @default(30)
  nationality    String    @default("Bangladeshi")
  applicationStart DateTime?
  applicationEnd   DateTime?
  detailsLink    String?   // সার্কুলার ইমেজ বা পিডিএফ লিংক
  applyLink      String?   // সরাসরি আবেদনের লিংক
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Foreign Keys
  jobTypeId      Int
  jobType        JobType   @relation(fields: [jobTypeId], references: [id])
  salaryScaleId  Int
  salaryScale    SalaryScale @relation(fields: [salaryScaleId], references: [id])
  
  // Relation to Education
  educations     JobEducation[]
}

model JobEducation {
  id             Int    @id @default(autoincrement())
  educationTitle String // e.g., 'BSc in CSE', 'HSC'
  requirements   String? @db.Text 
  jobId          String
  job            Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
}